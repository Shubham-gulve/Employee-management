NODE_ENV=development
PORT=3000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/employee-management

# Used to sign login tokens - at least 32 characters, keep it out of git
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=1d

# Browser origins allowed to call the API, comma separated
CLIENT_ORIGINS=http://localhost:5173

# Public sign-up stays off; the admin comes from the seed script
ALLOW_REGISTRATION=false

# Optional overrides for `npm run seed`
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
